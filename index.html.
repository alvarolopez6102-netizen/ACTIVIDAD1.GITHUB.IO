<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador de Utilidad: Taller de Pintura Automotriz</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Estilos personalizados mínimos para complementar Tailwind */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6; /* Gray 100 */
        }
        .input-group {
            position: relative;
        }
        .input-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af; /* Gray 400 */
        }
        .pl-10 {
            padding-left: 2.5rem !important;
        }
        /* Ocultar flechas en inputs de tipo number */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="text-gray-800 antialiased p-4 md:p-8">

    <div class="max-w-6xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden">
        
        <!-- Header -->
        <div class="bg-blue-600 text-white p-6 flex items-center gap-4">
            <div class="bg-white/20 p-3 rounded-full">
                <i class="fas fa-car-side text-2xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold">Simulador de Utilidad</h1>
                <p class="text-blue-100 text-sm">Comparador de Materiales para Taller de Pintura Automotriz</p>
            </div>
        </div>

        <div class="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Columna Izquierda: Entradas de Datos -->
            <div class="lg:col-span-1 space-y-6">
                
                <div class="bg-gray-50 p-5 rounded-xl border border-gray-200 shadow-sm">
                    <h2 class="text-lg font-semibold mb-4 text-gray-700 border-b pb-2">Datos Generales (Mensual)</h2>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" title="Renta, luz, agua, sueldos fijos, etc.">
                                Costos Fijos Mensuales
                                <i class="fas fa-info-circle text-gray-400 text-xs ml-1 cursor-help"></i>
                            </label>
                            <div class="input-group">
                                <i class="fas fa-dollar-sign input-icon"></i>
                                <input type="number" id="costosFijos" value="15000" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="Ej. 15000">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" title="¿A cuánto cobras en promedio pintar una pieza (ej. una puerta, facia)?">
                                Precio Venta por Pieza (Promedio)
                                <i class="fas fa-info-circle text-gray-400 text-xs ml-1 cursor-help"></i>
                            </label>
                            <div class="input-group">
                                <i class="fas fa-tag input-icon"></i>
                                <input type="number" id="precioVenta" value="1500" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="Ej. 1500">
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                Trabajos (Piezas) Estimados por Mes
                            </label>
                            <div class="flex items-center gap-4">
                                <input type="range" id="volumenTrabajosSlider" min="5" max="100" value="30" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                                <input type="number" id="volumenTrabajosInput" value="30" class="w-20 text-center border border-gray-300 rounded-lg py-1 font-semibold text-blue-600 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 p-5 rounded-xl border border-gray-200 shadow-sm">
                    <h2 class="text-lg font-semibold mb-4 text-gray-700 border-b pb-2">Costo de Materiales por Pieza</h2>
                    <p class="text-xs text-gray-500 mb-4">Ingresa el costo estimado de pintura, transparente, lijas, etc., para pintar UNA sola pieza usando cada nivel de calidad.</p>
                    
                    <div class="space-y-4">
                        <!-- Económico -->
                        <div class="p-3 bg-red-50 border border-red-100 rounded-lg">
                            <label class="block text-sm font-medium text-red-800 mb-1">
                                Calidad Económica
                            </label>
                            <div class="input-group">
                                <i class="fas fa-dollar-sign input-icon text-red-400"></i>
                                <input type="number" id="costoMaterialEco" value="300" class="w-full pl-10 pr-3 py-2 border border-red-200 rounded-lg focus:ring-red-500 focus:border-red-500 bg-white" placeholder="Costo material">
                            </div>
                        </div>

                        <!-- Estándar -->
                        <div class="p-3 bg-yellow-50 border border-yellow-100 rounded-lg">
                            <label class="block text-sm font-medium text-yellow-800 mb-1">
                                Calidad Estándar
                            </label>
                            <div class="input-group">
                                <i class="fas fa-dollar-sign input-icon text-yellow-500"></i>
                                <input type="number" id="costoMaterialStd" value="500" class="w-full pl-10 pr-3 py-2 border border-yellow-300 rounded-lg focus:ring-yellow-500 focus:border-yellow-500 bg-white" placeholder="Costo material">
                            </div>
                        </div>

                        <!-- Premium -->
                        <div class="p-3 bg-green-50 border border-green-100 rounded-lg">
                            <label class="block text-sm font-medium text-green-800 mb-1">
                                Calidad Premium
                            </label>
                            <div class="input-group">
                                <i class="fas fa-dollar-sign input-icon text-green-500"></i>
                                <input type="number" id="costoMaterialPrem" value="800" class="w-full pl-10 pr-3 py-2 border border-green-200 rounded-lg focus:ring-green-500 focus:border-green-500 bg-white" placeholder="Costo material">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                
                <!-- Tarjetas de Resumen Mensual -->
                <h2 class="text-xl font-bold text-gray-800 border-b pb-2 flex items-center gap-2">
                    <i class="fas fa-chart-line text-blue-500"></i> Proyección Mensual
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Tarjeta Económico -->
                    <div class="bg-white border-2 border-red-100 rounded-xl p-4 shadow-sm relative overflow-hidden transition-transform hover:scale-105">
                        <div class="absolute top-0 left-0 w-1 h-full bg-red-400"></div>
                        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Opción Económica</h3>
                        <div class="mb-4">
                            <p class="text-xs text-gray-500">Utilidad Neta Mensual</p>
                            <p class="text-2xl font-bold text-red-600" id="utilidadEco">$0</p>
                        </div>
                        <div class="space-y-1 text-sm border-t pt-2">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Ingresos:</span>
                                <span class="font-medium text-gray-800" id="ingresoEco">$0</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Margen por pieza:</span>
                                <span class="font-medium text-gray-800" id="margenEco">0%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta Estándar -->
                    <div class="bg-white border-2 border-yellow-200 rounded-xl p-4 shadow-sm relative overflow-hidden transition-transform hover:scale-105">
                        <div class="absolute top-0 left-0 w-1 h-full bg-yellow-400"></div>
                        <div class="absolute top-2 right-2 bg-yellow-100 text-yellow-800 text-[10px] font-bold px-2 py-1 rounded-full">
                            MÁS COMÚN
                        </div>
                        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Opción Estándar</h3>
                        <div class="mb-4">
                            <p class="text-xs text-gray-500">Utilidad Neta Mensual</p>
                            <p class="text-3xl font-bold text-yellow-600" id="utilidadStd">$0</p>
                        </div>
                        <div class="space-y-1 text-sm border-t pt-2">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Ingresos:</span>
                                <span class="font-medium text-gray-800" id="ingresoStd">$0</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Margen por pieza:</span>
                                <span class="font-medium text-gray-800" id="margenStd">0%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta Premium -->
                    <div class="bg-white border-2 border-green-200 rounded-xl p-4 shadow-sm relative overflow-hidden transition-transform hover:scale-105">
                        <div class="absolute top-0 left-0 w-1 h-full bg-green-500"></div>
                        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Opción Premium</h3>
                        <div class="mb-4">
                            <p class="text-xs text-gray-500">Utilidad Neta Mensual</p>
                            <p class="text-2xl font-bold text-green-600" id="utilidadPrem">$0</p>
                        </div>
                        <div class="space-y-1 text-sm border-t pt-2">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Ingresos:</span>
                                <span class="font-medium text-gray-800" id="ingresoPrem">$0</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Margen por pieza:</span>
                                <span class="font-medium text-gray-800" id="margenPrem">0%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                    <!-- Gráfica de Utilidad Comparativa -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-sm font-semibold text-gray-700 text-center mb-4">Utilidad Neta vs Costos (Mensual)</h3>
                        <div class="relative h-64 w-full">
                            <canvas id="chartUtilidad"></canvas>
                        </div>
                    </div>

                    <!-- Gráfica de Composición del Precio -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-sm font-semibold text-gray-700 text-center mb-4">Desglose por Pieza Pintada</h3>
                        <div class="relative h-64 w-full flex justify-center">
                            <canvas id="chartDesglose"></canvas>
                        </div>
                        <p class="text-[10px] text-center text-gray-400 mt-2">*El costo fijo se prorratea por pieza</p>
                    </div>
                </div>

                <!-- Alerta/Consejo Dinámico -->
                <div id="insightAlert" class="mt-4 p-4 rounded-lg bg-blue-50 border border-blue-200 text-sm text-blue-800 flex gap-3 items-start">
                    <i class="fas fa-lightbulb text-blue-500 mt-1"></i>
                    <div>
                        <p class="font-semibold mb-1">Análisis Rápido:</p>
                        <p id="insightText">Calculando la mejor estrategia para tu taller...</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // Referencias a los elementos del DOM
            const inputs = {
                fijos: document.getElementById('costosFijos'),
                venta: document.getElementById('precioVenta'),
                volumenSlider: document.getElementById('volumenTrabajosSlider'),
                volumenInput: document.getElementById('volumenTrabajosInput'),
                matEco: document.getElementById('costoMaterialEco'),
                matStd: document.getElementById('costoMaterialStd'),
                matPrem: document.getElementById('costoMaterialPrem')
            };

            const outputs = {
                eco: {
                    utilidad: document.getElementById('utilidadEco'),
                    ingreso: document.getElementById('ingresoEco'),
                    margen: document.getElementById('margenEco')
                },
                std: {
                    utilidad: document.getElementById('utilidadStd'),
                    ingreso: document.getElementById('ingresoStd'),
                    margen: document.getElementById('margenStd')
                },
                prem: {
                    utilidad: document.getElementById('utilidadPrem'),
                    ingreso: document.getElementById('ingresoPrem'),
                    margen: document.getElementById('margenPrem')
                },
                insight: document.getElementById('insightText')
            };

            // Variables para las instancias de las gráficas
            let chartUtilidadInst = null;
            let chartDesgloseInst = null;

            // Formateador de moneda
            const formatCurrency = (val) => {
                return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(val);
            };

            // Sincronizar Slider con Input de Volumen
            inputs.volumenSlider.addEventListener('input', (e) => {
                inputs.volumenInput.value = e.target.value;
                calcular();
            });
            inputs.volumenInput.addEventListener('input', (e) => {
                let val = parseInt(e.target.value);
                if (val < 0) val = 0;
                inputs.volumenSlider.value = val;
                calcular();
            });

            // Agregar event listeners a todos los inputs numéricos
            Object.values(inputs).forEach(input => {
                if (input.type === 'number' && input.id !== 'volumenTrabajosInput') {
                    input.addEventListener('input', calcular);
                }
            });

            // Función principal de cálculo
            function calcular() {
                // Obtener valores parseados (evitar NaN si se borra el input)
                const getVal = (el) => parseFloat(el.value) || 0;

                const cFijos = getVal(inputs.fijos);
                const pVenta = getVal(inputs.venta);
                const volumen = getVal(inputs.volumenInput);
                
                const cMat = {
                    eco: getVal(inputs.matEco),
                    std: getVal(inputs.matStd),
                    prem: getVal(inputs.matPrem)
                };

                // Cálculos Mensuales
                const ingresosMensuales = pVenta * volumen;

                const costosVariables = {
                    eco: cMat.eco * volumen,
                    std: cMat.std * volumen,
                    prem: cMat.prem * volumen
                };

                const costoTotal = {
                    eco: cFijos + costosVariables.eco,
                    std: cFijos + costosVariables.std,
                    prem: cFijos + costosVariables.prem
                };

                const utilidadNeta = {
                    eco: ingresosMensuales - costoTotal.eco,
                    std: ingresosMensuales - costoTotal.std,
                    prem: ingresosMensuales - costoTotal.prem
                };

                // Cálculos por Pieza (para desglose)
                const costoFijoPorPieza = volumen > 0 ? cFijos / volumen : 0;
                
                const gananciaPorPieza = {
                    eco: pVenta - cMat.eco - costoFijoPorPieza,
                    std: pVenta - cMat.std - costoFijoPorPieza,
                    prem: pVenta - cMat.prem - costoFijoPorPieza
                };

                const margen = {
                    eco: pVenta > 0 ? (gananciaPorPieza.eco / pVenta) * 100 : 0,
                    std: pVenta > 0 ? (gananciaPorPieza.std / pVenta) * 100 : 0,
                    prem: pVenta > 0 ? (gananciaPorPieza.prem / pVenta) * 100 : 0
                };

                // --- Actualizar Interfaz (Tarjetas) ---
                const updateCard = (tipo, util, ing, marg) => {
                    const el = outputs[tipo];
                    el.utilidad.textContent = formatCurrency(util);
                    // Color rojo si hay pérdidas
                    el.utilidad.className = util < 0 
                        ? `text-2xl font-bold text-red-600` 
                        : `text-2xl font-bold text-${tipo === 'eco' ? 'red' : tipo === 'std' ? 'yellow' : 'green'}-600`;
                    
                    if (tipo === 'std') el.utilidad.className = el.utilidad.className.replace('text-2xl', 'text-3xl'); // Resaltar std
                    
                    el.ingreso.textContent = formatCurrency(ing);
                    el.margen.textContent = marg.toFixed(1) + '%';
                };

                updateCard('eco', utilidadNeta.eco, ingresosMensuales, margen.eco);
                updateCard('std', utilidadNeta.std, ingresosMensuales, margen.std);
                updateCard('prem', utilidadNeta.prem, ingresosMensuales, margen.prem);

                generarInsight(utilidadNeta, volumen, cFijos, pVenta);
                actualizarGraficas(utilidadNeta, costoTotal, cMat, costoFijoPorPieza, gananciaPorPieza);
            }

            function generarInsight(utilidades, volumen, fijos, venta) {
                const puntoEquilibrio = (fijos / (venta - parseFloat(inputs.matStd.value))) || 0;
                let texto = "";

                if (volumen === 0) {
                    texto = "Sin trabajos no hay ingresos. Aumenta el volumen para ver proyecciones.";
                } else if (utilidades.std < 0) {
                    texto = `🚨 Estás operando con <strong>pérdidas</strong> con materiales estándar. Necesitas pintar al menos <strong>${Math.ceil(puntoEquilibrio)} piezas al mes</strong> para cubrir tus costos fijos de ${formatCurrency(fijos)}.`;
                } else {
                    const difPremEco = utilidades.eco - utilidades.prem;
                    if (difPremEco > 0) {
                        texto = `✅ Tu punto de equilibrio es de aprox. ${Math.ceil(puntoEquilibrio)} piezas. Usar materiales económicos te deja ${formatCurrency(difPremEco)} más que la línea premium. <strong>Consideración:</strong> Evalúa si la calidad inferior afecta las recomendaciones y regresos de clientes a largo plazo.`;
                    } else {
                         texto = `Tus números están saludables.`;
                    }
                }
                outputs.insight.innerHTML = texto;
            }

            function actualizarGraficas(utilidades, costos, cMat, costoFijoUnitario, gananciaUnit) {
                
                // Colores
                const colEco = 'rgba(239, 68, 68, 0.8)'; // Red 500
                const colStd = 'rgba(234, 179, 8, 0.8)';  // Yellow 500
                const colPrem = 'rgba(34, 197, 94, 0.8)'; // Green 500
                const colCostos = 'rgba(156, 163, 175, 0.5)'; // Gray 400

                // 1. Gráfica de Barras (Utilidad Mensual)
                const ctxUtil = document.getElementById('chartUtilidad').getContext('2d');
                
                if (chartUtilidadInst) {
                    chartUtilidadInst.destroy();
                }

                chartUtilidadInst = new Chart(ctxUtil, {
                    type: 'bar',
                    data: {
                        labels: ['Económica', 'Estándar', 'Premium'],
                        datasets: [
                            {
                                label: 'Utilidad Neta',
                                data: [utilidades.eco, utilidades.std, utilidades.prem],
                                backgroundColor: [colEco, colStd, colPrem],
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (context) => formatCurrency(context.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: (value) => '$' + value
                                }
                            }
                        }
                    }
                });

                // 2. Gráfica de Anillo (Desglose por Pieza de la opción Estándar)
                // Se usa la estándar como referencia visual principal
                const ctxDesglose = document.getElementById('chartDesglose').getContext('2d');
                
                if (chartDesgloseInst) {
                    chartDesgloseInst.destroy();
                }

                // Evitar valores negativos en la gráfica de anillo (si hay pérdida)
                const gananciaMostrar = gananciaUnit.std > 0 ? gananciaUnit.std : 0;
                let dataDesglose = [cMat.std, costoFijoUnitario, gananciaMostrar];
                
                // Si la ganancia es menor a 0, la porción del costo fijo "se come" a la ganancia
                if(gananciaUnit.std < 0){
                   // Data aproximada para visualización de pérdida unitaria
                   dataDesglose = [cMat.std, costoFijoUnitario, 0];
                }

                chartDesgloseInst = new Chart(ctxDesglose, {
                    type: 'doughnut',
                    data: {
                        labels: ['Material Estándar', 'Costo Fijo (Prorrateado)', 'Ganancia Libre'],
                        datasets: [{
                            data: dataDesglose,
                            backgroundColor: [
                                '#FDE047', // yellow-300
                                '#9CA3AF', // gray-400
                                '#4ADE80'  // green-400
                            ],
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    font: { size: 11 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: (context) => {
                                        const label = context.label || '';
                                        const val = formatCurrency(context.raw);
                                        return ` ${label}: ${val}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Inicializar cálculos al cargar la página
            calcular();
        });
    </script>
</body>
</html>
